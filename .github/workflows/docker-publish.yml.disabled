
name: Build Test and Publish Wine Quality Docker Image

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: wine-quality-ml

jobs:
  build-test-publish:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t $IMAGE_NAME:ci .

      - name: Start test container
        run: |
          docker run -d \
            --name wine-quality-ci \
            -p 5000:5000 \
            $IMAGE_NAME:ci

      - name: Test API health endpoint
        run: |
          for attempt in {1..20}; do
            if curl --fail --silent http://localhost:5000/health; then
              echo "Health check passed."
              exit 0
            fi
            echo "Waiting for API..."
            sleep 3
          done

          echo "Health check failed."
          docker logs wine-quality-ci
          exit 1

      - name: Test prediction endpoint
        run: |
          curl --fail --silent \
            -X POST http://localhost:5000/predict \
            -H "Content-Type: application/json" \
            -d '{
              "fixed acidity": 7.4,
              "volatile acidity": 0.70,
              "citric acid": 0.00,
              "residual sugar": 1.9,
              "chlorides": 0.076,
              "free sulfur dioxide": 11,
              "total sulfur dioxide": 34,
              "density": 0.9978,
              "pH": 3.51,
              "sulphates": 0.56,
              "alcohol": 9.4
            }'
          echo "Prediction test passed."

      - name: Remove test container
        if: always()
        run: docker rm -f wine-quality-ci || true

      - name: Create lowercase GHCR image name
        run: |
          IMAGE_ID="ghcr.io/${GITHUB_REPOSITORY_OWNER,,}/${IMAGE_NAME}"
          echo "IMAGE_ID=$IMAGE_ID" >> "$GITHUB_ENV"

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Tag tested image
        run: |
          docker tag $IMAGE_NAME:ci $IMAGE_ID:latest
          docker tag $IMAGE_NAME:ci $IMAGE_ID:sha-${{ github.sha }}

      - name: Push tested image to GHCR
        run: |
          docker push $IMAGE_ID:latest
          docker push $IMAGE_ID:sha-${{ github.sha }}
